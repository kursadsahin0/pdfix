{
  "name": "pdfix",
  "version": "0.0.1",
  "description": "PDFix — modern PDF editor built with Quasar and Vue 3",
  "productName": "PDFix",
  "author": "kursadsahin0 <kursatsahin565@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,vue,css,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,vue,css,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "build:mobile": "quasar build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@quasar/extras": "^2.1.0",
    "autoprefixer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "postcss": "^8.5.28",
    "quasar": "^2.32.3",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.8.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "sass": "^1.104.1",
    "sass-embedded": "^1.104.1",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
